# Copy this file to .env before running locally.

# Generation provider.
# Use "ollama" for local generation or switch to a Groq-backed flow if desired.
LLM_PROVIDER=ollama

# Required only when using Groq-backed generation or tracing.
GROQ_API_KEY=

# PostgreSQL connection string.
# This matches the database created by docker-compose.yml.
DATABASE_URL=postgresql://postgres:password@localhost:5432/medrag

# Ollama configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Evaluation model settings.
RAGAS_JUDGE_PROVIDER=ollama
RAGAS_JUDGE_MODEL=llama3.1:latest

# Optional retry tuning.
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_SECONDS=10
GROQ_RETRY_MAX_SECONDS=180

# Retrieval tuning.
RETRIEVAL_CANDIDATE_MULTIPLIER=3
STRATEGY_C_ENABLE_DIVERSITY_RERANKING=true
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_MAX_SIMILARITY=0.92

# Data split settings.
CHATDOCTOR_EVAL_RECORDS_PER_CATEGORY=20
DATA_SPLIT_SEED=42
